# Production (Render, Railway, etc.)
NODE_ENV=production
PORT=3000
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE?schema=public

# Secret JWT (obligatoire en production si vous utilisez encore /api/auth)
JWT_SECRET=changez-moi-avec-une-chaine-longue-et-aleatoire

# Origines frontend autorisées (séparées par des virgules)
CORS_ORIGIN=https://votre-app.vercel.app,https://www.votre-domaine.gn

# MQTT (optionnel — l’API HTTP démarre même si le broker est absent)
MQTT_BROKER_URL=mqtt://localhost:1883
MQTT_CLIENT_ID=meteo-energetique-api
