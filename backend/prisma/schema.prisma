// Hiérarchie : Région → Commune → Quartier → Secteur (PostGIS + power_status)

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  url        = env("DATABASE_URL")
  extensions = [postgis(schema: "public")]
}

model Region {
  id        Int       @id @default(autoincrement())
  name      String    @unique @db.VarChar(100)
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  communes  Commune[]
  sectors   Sector[]

  @@map("regions")
}

model Commune {
  id        Int       @id @default(autoincrement())
  regionId  Int       @map("region_id")
  name      String    @db.VarChar(100)
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  region    Region    @relation(fields: [regionId], references: [id], onDelete: Cascade)
  quartiers Quartier[]
  sectors   Sector[]
  users     User[]

  @@unique([regionId, name], map: "unique_commune_per_region")
  @@map("communes")
}

model Quartier {
  id        Int      @id @default(autoincrement())
  communeId Int      @map("commune_id")
  name      String   @db.VarChar(100)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  commune Commune  @relation(fields: [communeId], references: [id], onDelete: Cascade)
  sectors Sector[]
  users   User[]

  @@unique([communeId, name], map: "unique_quartier_per_commune")
  @@map("quartiers")
}

model Sector {
  id         Int      @id @default(autoincrement())
  regionId   Int      @map("region_id")
  communeId  Int      @map("commune_id")
  quartierId Int      @map("quartier_id")
  name       String   @db.VarChar(100)
  boundary   Unsupported("geometry(Point,4326)")?
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  region      Region       @relation(fields: [regionId], references: [id], onDelete: Cascade)
  commune     Commune      @relation(fields: [communeId], references: [id], onDelete: Cascade)
  quartier    Quartier     @relation(fields: [quartierId], references: [id], onDelete: Cascade)
  users       User[]
  iotKits     IotKit[]
  powerStatus PowerStatus?
  powerLogs   PowerLog[]
  userReports UserReport[]

  @@unique([quartierId, name], map: "unique_sector_per_quartier")
  @@map("sectors")
}

model User {
  id              Int      @id @default(autoincrement())
  phoneNumber     String   @unique @map("phone_number") @db.VarChar(20)
  firstName       String?  @map("first_name") @db.VarChar(80)
  lastName        String?  @map("last_name") @db.VarChar(80)
  name            String?  @db.VarChar(160)
  role            String   @default("citizen") @db.VarChar(20)
  communeId       Int?     @map("commune_id")
  quartierId      Int?     @map("quartier_id")
  defaultSectorId Int?     @map("default_sector_id")
  notifySms       Boolean  @default(false) @map("notify_sms")
  notifyWhatsapp  Boolean  @default(false) @map("notify_whatsapp")
  notifyInApp     Boolean  @default(true) @map("notify_in_app")
  fcmToken        String?  @map("fcm_token")
  isVerified      Boolean  @default(false) @map("is_verified")
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  commune       Commune?     @relation(fields: [communeId], references: [id], onDelete: SetNull)
  quartier      Quartier?    @relation(fields: [quartierId], references: [id], onDelete: SetNull)
  defaultSector Sector?      @relation(fields: [defaultSectorId], references: [id], onDelete: SetNull)
  reports       UserReport[]
  notifications NotificationOutbox[]

  @@map("users")
}

model IotKit {
  id           String    @id @db.VarChar(50)
  sectorId     Int       @map("sector_id")
  locationName String    @map("location_name") @db.VarChar(150)
  isActive     Boolean   @default(true) @map("is_active")
  lastPing     DateTime? @map("last_ping") @db.Timestamptz(6)
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  sector    Sector     @relation(fields: [sectorId], references: [id], onDelete: Cascade)
  powerLogs PowerLog[]

  @@map("iot_kits")
}

model PowerStatus {
  sectorId            Int       @id @map("sector_id")
  currentState        String    @default("ONLINE") @map("current_state") @db.VarChar(20)
  lastUpdated         DateTime  @default(now()) @map("last_updated") @db.Timestamptz(6)
  estimatedReturnTime DateTime? @map("estimated_return_time") @db.Timestamptz(6)
  confidenceScore     Int       @default(100) @map("confidence_score")

  sector Sector @relation(fields: [sectorId], references: [id], onDelete: Cascade)

  @@map("power_status")
}

model PowerLog {
  id             BigInt   @id @default(autoincrement())
  sectorId       Int      @map("sector_id")
  kitId          String?  @map("kit_id") @db.VarChar(50)
  stateChangedTo String   @map("state_changed_to") @db.VarChar(20)
  changedAt      DateTime @default(now()) @map("changed_at") @db.Timestamptz(6)

  sector Sector  @relation(fields: [sectorId], references: [id], onDelete: Cascade)
  kit    IotKit? @relation(fields: [kitId], references: [id], onDelete: SetNull)

  @@index([sectorId, changedAt(sort: Desc)], map: "idx_power_logs_sector_time")
  @@map("power_logs")
}

model UserReport {
  id           BigInt   @id @default(autoincrement())
  userId       Int?     @map("user_id")
  sectorId     Int      @map("sector_id")
  reportType   String   @map("report_type") @db.VarChar(30)
  reportedAt   DateTime @default(now()) @map("reported_at") @db.Timestamptz(6)
  userLocation Unsupported("geometry(Point,4326)")? @map("user_location")

  user   User?  @relation(fields: [userId], references: [id], onDelete: SetNull)
  sector Sector @relation(fields: [sectorId], references: [id], onDelete: Cascade)

  @@index([reportedAt(sort: Desc)], map: "idx_user_reports_time")
  @@map("user_reports")
}

/** Contenus Info (actualités, panels, textes) — canaux préparés, sans envoi SMS/WhatsApp. */
model InfoPublication {
  id            Int       @id @default(autoincrement())
  tab           String    @db.VarChar(20)
  badge         String    @default("officiel") @db.VarChar(20)
  title         String    @db.VarChar(220)
  summary       String    @db.VarChar(400)
  body          String
  zoneLabel     String    @map("zone_label") @db.VarChar(160)
  communeId     Int?      @map("commune_id")
  quartierId    Int?      @map("quartier_id")
  sectorId      Int?      @map("sector_id")
  shortMessage  String?   @map("short_message") @db.VarChar(160)
  channelInApp  Boolean   @default(true) @map("channel_in_app")
  channelSms    Boolean   @default(false) @map("channel_sms")
  channelWhatsapp Boolean @default(false) @map("channel_whatsapp")
  status        String    @default("published") @db.VarChar(20)
  publishedAt   DateTime  @default(now()) @map("published_at") @db.Timestamptz(6)
  createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  outbox NotificationOutbox[]

  @@index([tab, publishedAt(sort: Desc)], map: "idx_info_tab_published")
  @@map("info_publications")
}

/** File d’envoi prévue (queued uniquement — aucun SMS/WhatsApp n’est envoyé). */
model NotificationOutbox {
  id             Int      @id @default(autoincrement())
  publicationId  Int      @map("publication_id")
  userId         Int      @map("user_id")
  channel        String   @db.VarChar(20)
  status         String   @default("queued") @db.VarChar(20)
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  publication InfoPublication @relation(fields: [publicationId], references: [id], onDelete: Cascade)
  user        User            @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([publicationId, userId, channel], map: "unique_outbox_user_channel")
  @@index([status, channel], map: "idx_outbox_status_channel")
  @@map("notification_outbox")
}
